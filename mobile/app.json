{
  "expo": {
    "name": "my.gov tracker",
    "slug": "mygov-tracker",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B0B0D",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "uz.turonproject.tracker",
      "googleServicesFile": "./google-services.json",
      "versionCode": 2,
      "permissions": [
        "REQUEST_INSTALL_PACKAGES"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7F7F8",
          "dark": {
            "backgroundColor": "#0B0B0D"
          },
          "imageWidth": 120,
          "image": "./assets/icon.png"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0B0B0D",
          "defaultChannel": "status-changes",
          "enableRemoteNotifications": true
        }
      ],
      "expo-sharing",
      [
        "expo-camera",
        {
          "cameraPermission": "Камера нужна, чтобы отсканировать QR привязки с сайта трекера.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ]
    ],
    "scheme": "mygovtracker",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiBaseUrl": "https://tracker.turonproject.uz",
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "271d2f4d-6932-489a-8b12-a7a6dda37a9e"
      }
    },
    "owner": "utkirov",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/271d2f4d-6932-489a-8b12-a7a6dda37a9e",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
