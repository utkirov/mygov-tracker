{
  "expo": {
    "name": "my.gov tracker",
    "slug": "mygov-tracker",
    "version": "1.3.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B0B0D",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "uz.turonproject.tracker",
      "googleServicesFile": "./google-services.json",
      "versionCode": 5,
      "permissions": [
        "REQUEST_INSTALL_PACKAGES",
        "android.permission.POST_PROMOTED_NOTIFICATIONS"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "category": [
            "DEFAULT"
          ],
          "data": [
            {
              "scheme": "content",
              "mimeType": "application/pdf"
            },
            {
              "scheme": "file",
              "mimeType": "application/pdf"
            }
          ]
        }
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7F7F8",
          "dark": {
            "backgroundColor": "#0B0B0D"
          },
          "imageWidth": 120,
          "image": "./assets/icon.png"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0B0B0D",
          "defaultChannel": "status-changes",
          "enableRemoteNotifications": true
        }
      ],
      "expo-sharing",
      [
        "expo-camera",
        {
          "cameraPermission": "РљР°РјРµСЂР° РЅСѓР¶РЅР°, С‡С‚РѕР±С‹ РѕС‚СЃРєР°РЅРёСЂРѕРІР°С‚СЊ QR РїСЂРёРІСЏР·РєРё СЃ СЃР°Р№С‚Р° С‚СЂРµРєРµСЂР°.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-background-task",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "Tracker",
              "label": "my.gov tracker",
              "description": "РЎРєРѕР»СЊРєРѕ Р·Р°СЏРІР»РµРЅРёР№ Р¶РґСѓС‚ РІР°С€РµРіРѕ РґРµР№СЃС‚РІРёСЏ Рё РїРѕСЃР»РµРґРЅРёРµ РёР·РјРµРЅРµРЅРёСЏ",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "maxResizeHeight": "400dp",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": [
              "arm64-v8a"
            ]
          }
        }
      ]
    ],
    "scheme": "mygovtracker",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiBaseUrl": "https://tracker.turonproject.uz",
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "271d2f4d-6932-489a-8b12-a7a6dda37a9e"
      }
    },
    "owner": "utkirov",
    "runtimeVersion": {
