/node_modules
/.pnp
.pnp.*

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# Electron / packaged binaries
/dist/
/electron/dist/
*.exe
*.msi

# IDE
.vscode/
.idea/

# typescript
*.tsbuildinfo
next-env.d.ts

# superpowers / worktrees
.superpowers/
.worktrees/

# local runtime data (not versioned)
/data/local-db.json
/data/local-db.sqlite
/data/local-db.sqlite-shm
/data/local-db.sqlite-wal
/data/scheduler-status.json
/data/pdfs/

