{
  "name": "mygov-tracker",
  "version": "1.0.0",
  "description": "Трекер заявок my.gov.uz",
  "private": true,
  "scripts": {
    "dev": "node server.mjs --dev",
    "build": "next build",
    "start": "node server.mjs",
    "lint": "eslint",
    "test": "jest",
    "autostart": "node scripts/autostart.mjs install",
    "autostart:remove": "node scripts/autostart.mjs remove"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testPathIgnorePatterns": ["/node_modules/", "<rootDir>/mobile/"],
    "modulePathIgnorePatterns": ["<rootDir>/mobile/"],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1"
    },
    "collectCoverageFrom": [
      "lib/**/*.ts",
      "app/api/**/*.ts",
      "!**/*.d.ts",
      "!lib/__tests__/**"
    ]
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "better-sqlite3": "^12.10.0",
    "cheerio": "^1.2.0",
    "lucide-react": "^1.16.0",
    "next": "16.2.4",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^1.1.4",
    "puppeteer-core": "^25.3.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "jest": "^30.3.0",
    "tailwindcss": "^4",
    "ts-jest": "^29.4.9",
    "typescript": "^5"
  }
}
